# Application
APP_NAME="Video Conferencing Platform API"
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./app.db

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Meeting
INVITE_BASE_URL=http://localhost:3000/join
MEETING_ID_LENGTH=10

# Seed data
SEED_ON_STARTUP=true

# Logging
LOG_LEVEL=INFO
